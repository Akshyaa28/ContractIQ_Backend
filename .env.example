# =============================================================
# ContractIQ — Environment Variables
# =============================================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# These values are used by the FastAPI application.
# =============================================================

# --- Application ---
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/contractiq

# --- JWT Authentication ---
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# --- CORS ---
# Comma-separated list of allowed origins.
# Use "*" only during development.
CORS_ORIGINS=*

# --- Model Paths (override defaults if models are stored elsewhere) ---
# Leave blank to use the default paths relative to project root.
# On AWS Lambda, set these to /tmp/ paths where models are downloaded at cold start.
# RISK_MODEL_PATH=
# FORECAST_MODEL_PATH=
# QUALITY_MODEL_PATH=
# TWIN_MODEL_DIR=
# TWIN_REFERENCE_DATA_PATH=

# --- AWS (for Lambda/S3 deployment) ---
# AWS_REGION=us-east-1
# S3_MODEL_BUCKET=contractiq-models
# S3_MODEL_PREFIX=production/

# --- Logging ---
LOG_LEVEL=INFO
